# Renga — 環境変数テンプレート
#
# 使い方:
#   1. このファイルを .env としてコピーする: cp .env.example .env
#   2. 各値を実際の認証情報・IDに置き換える
#   3. .env は絶対にコミットしない（.gitignore 済み）
#
# ここに定義する変数は主に以下で利用する:
#   - Supabase CLI（npx supabase ...）
#   - Firebase CLI / FlutterFire CLI（npx firebase-tools ..., flutterfire configure）
#   - Gemini API（Edge Function経由でのAI機能）
#   - Mux（動画アップロード・配信）
#   - AdMob / Flutterアプリのビルド設定
#
# 詳細は design/system.md の「11. 開発環境・CLI運用」を参照。

# ─────────────────────────────
# プロジェクト共通
# ─────────────────────────────
PROJECT_NAME=renga
APP_PACKAGE_ID=com.minnya.renga

# ─────────────────────────────
# Supabase CLI / バックエンド
# ─────────────────────────────
# Supabaseダッシュボード > Account > Access Tokens で発行（CLIの非対話ログインに使用）
SUPABASE_ACCESS_TOKEN=

# Supabaseプロジェクトの参照ID（プロジェクトURL https://<ref>.supabase.co の <ref> 部分）
SUPABASE_PROJECT_REF=

# `supabase link` / マイグレーション実行時に使うDBパスワード（Supabaseダッシュボードで設定したもの）
SUPABASE_DB_PASSWORD=

# Flutterアプリ（クライアント）から参照する値。公開して問題ない値（anon key）のみ
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Supabaseプロジェクト作成時のリージョン（US東/西いずれか。ダッシュボードまたは
# `supabase projects create --region` で指定。CLIのinit/link自体には設定不要）
SUPABASE_REGION=us-east-1

# Google Sign-In（Supabase Auth > Providers > Google で有効化する際に登録）
# Google Cloud Console > APIs & Services > Credentials で発行
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─────────────────────────────
# Firebase CLI / FlutterFire CLI
# ─────────────────────────────
FIREBASE_PROJECT_ID=renga

# `firebase login:ci` で発行するCIトークン（非対話ログイン用）
FIREBASE_TOKEN=

# Firebase Admin SDK用サービスアカウントJSONのファイルパス（gcloud iam service-accounts keys create で発行）
# Edge FunctionのFCM送信・Firebase管理操作の両方で使用
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# Supabase Edge Function `send_push_notification` 用（design/system.md 4章「通知アーキテクチャ」）。
# 上記サービスアカウントJSONファイルの中身をそのまま1行の文字列として設定する
# （`npx supabase secrets set FIREBASE_SERVICE_ACCOUNT_JSON="$(cat ./secrets/firebase-service-account.json)"` 等）。
# FCM HTTP v1 APIへの送信用アクセストークン取得（Google OAuth2 JWTのRS256署名）に使用する。
FIREBASE_SERVICE_ACCOUNT_JSON=

# Supabase Edge Function `translate_text` 用（design/system.md 6.5節「テキスト翻訳」）。
# 上記と同じサービスアカウントJSONだが、生JSON（改行・引用符を含む）をシェル経由で
# `secrets set` すると、Windows等の環境でクォーティングが壊れて破損することがあるため、
# base64エンコードした文字列として設定する
# （`node -e "console.log(Buffer.from(require('fs').readFileSync('./secrets/firebase-service-account.json')).toString('base64'))"`
# の出力を `npx supabase secrets set FIREBASE_SERVICE_ACCOUNT_JSON_B64=<出力値>` に渡す等）。
# Cloud Translation API v3呼び出し用のアクセストークン取得にも同じOAuth2 JWT方式を使う。
# GCPコンソールで「Cloud Translation API」を有効化したうえで、このサービスアカウントに
# 「Cloud Translation API User」(roles/cloudtranslate.user) ロールを追加付与しておくこと。
FIREBASE_SERVICE_ACCOUNT_JSON_B64=

# ─────────────────────────────
# Gemini API（ドメインラベリング・クイズ自動生成パイプライン）
# ─────────────────────────────
# Google AI Studio (https://aistudio.google.com) で発行
GEMINI_API_KEY=

# ─────────────────────────────
# Mux（動画アップロード・エンコード・HLS配信）
# ─────────────────────────────
# Mux Dashboard (https://dashboard.mux.com) > Settings > API Access Tokens で発行
# 開始時はFreeプラン（月間配信100,000分無料、保存本数は最大10本まで）。
# 規模拡大時はDashboardの請求設定からPay as you go / Pre-payへ切り替え可能（コード変更不要）
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Mux Dashboard > Settings > Webhooks で発行するWebhook署名検証用シークレット
MUX_WEBHOOK_SIGNING_SECRET=

# ─────────────────────────────
# AdMob（広告）
# ─────────────────────────────
ADMOB_APP_ID_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_APP_ID_IOS=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_NATIVE_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_INTERSTITIAL_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# ─────────────────────────────
# Flutterビルド設定
# ─────────────────────────────
# dev | prod（ビルドフレーバーの切り替え。広告IDのテスト/本番切り替え等に使用）
FLUTTER_APP_ENV=dev
